# Airtable Configuration (Optional - app works with test data if not provided)
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# Server Configuration
NODE_ENV=development  # or 'production'
PORT=5000            # Server port (default: 5000, auto-increments if busy)
HOST=0.0.0.0         # Server host (default: 0.0.0.0)

# Admin API (REQUIRED in production)
# Gates POST /api/admin/refresh and POST /api/cache/refresh. These endpoints
# invalidate all caches and force full Airtable re-fetches, so leaving them
# open lets anyone exhaust the Airtable rate limit. When unset, the endpoints
# return 503 in production and stay open in development.
# Send as `Authorization: Bearer <token>` or `X-Admin-Token: <token>`.
ADMIN_TOKEN=

# Webhooks (REQUIRED in production)
# Gates POST /api/webhooks/*. Same failure mode as ADMIN_TOKEN: 503 in
# production when unset, open in development.
# Send as `X-Webhook-Secret: <secret>` (preferred) or in the JSON body.
WEBHOOK_SECRET=

# Image proxy allowlist (optional)
# Comma-separated hosts /api/images/:url may fetch from. Overrides the
# built-in default (i.ibb.co, imgur, Airtable CDNs). Subdomains are matched.
IMAGE_HOST_ALLOWLIST=

# Image fetch timeouts in ms (optional)
# The image CDN is slow on cold objects (~30-60 KB/s), so background
# pre-caching gets a far longer budget than a request a browser is waiting on.
IMAGE_FETCH_TIMEOUT_MS=            # foreground, default 20000
IMAGE_BACKGROUND_FETCH_TIMEOUT_MS= # pre-cache/refresh, default 180000

# Logging (optional)
# Set to any value to emit per-request API logs in production.
LOG_REQUESTS=
